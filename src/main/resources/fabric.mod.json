{
  "schemaVersion": 1,
  "id": "speech-to-chat",
  "version": "${version}",
  "name": "Speech to Chat",
  "description": "Push-to-talk speech-to-text for chat, with a live preview. Runs locally with whisper.cpp (Vulkan, Metal or CPU).",
  "authors": [
    "splice11"
  ],
  "contributors": [
    "Lunaposs (original Speech To Text Accessibility mod)",
    "Orion (original Speech To Text Accessibility mod)"
  ],
  "license": "GPL-3.0-only",
  "icon": "assets/speech-to-chat/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.stta.STTAClient"
    ],
    "modmenu": [
      "com.stta.config.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "recommends": {
    "modmenu": "*",
    "yet_another_config_lib_v3": "*"
  },
  "contact": {
    "homepage": "https://modrinth.com/mod/speech-to-chat",
    "sources": "https://github.com/splice11/speech-to-chat",
    "issues": "https://github.com/splice11/speech-to-chat/issues"
  }
}
